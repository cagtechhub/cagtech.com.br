{
  "name": "cagtech-com-br",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"yarn workspace @cagtech/web dev\" \"yarn workspace @cagtech/backend dev\"",
    "dev:web": "yarn workspace @cagtech/web dev",
    "dev:api": "yarn workspace @cagtech/backend dev",
    "build": "yarn workspace @cagtech/shared build && yarn workspace @cagtech/backend build && yarn workspace @cagtech/web build",
    "lint": "yarn workspace @cagtech/shared lint && yarn workspace @cagtech/backend lint && yarn workspace @cagtech/web lint",
    "lint:fix": "yarn workspace @cagtech/web lint:fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:generate": "yarn workspace @cagtech/backend db:generate",
    "db:migrate": "yarn workspace @cagtech/backend db:migrate"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.0"
  },
  "resolutions": {
    "vue": "3.5.40",
    "@vue/compiler-core": "3.5.40",
    "@vue/compiler-dom": "3.5.40",
    "@vue/compiler-sfc": "3.5.40",
    "@vue/reactivity": "3.5.40",
    "@vue/runtime-core": "3.5.40",
    "@vue/runtime-dom": "3.5.40",
    "@vue/server-renderer": "3.5.40",
    "@vue/shared": "3.5.40"
  }
}
