# Copie para `.env` só na VPS. Não commitar segredos.

DOMAIN=cagtech.com.br
API_DOMAIN=api.cagtech.com.br

# Traefik
TRAEFIK_NETWORK=web
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Postgres do Supabase (pooler). Sem serviço db no Compose.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=cagtech

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# Service role só no backend — nunca em NUXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

NUXT_PUBLIC_API_BASE=https://api.cagtech.com.br
NUXT_PUBLIC_SITE_URL=https://cagtech.com.br
NUXT_PUBLIC_SITE_NAME=CAG Tech
NUXT_PUBLIC_NO_INDEX=false
NUXT_PUBLIC_SEO_LOCALITY=Campo Grande, MS
NUXT_PUBLIC_BUSINESS_PHONE=+5567992110928
NUXT_PUBLIC_CONTACT_EMAIL=
NUXT_PUBLIC_LINKEDIN_URL=
NUXT_PUBLIC_DEFAULT_OG_IMAGE=/og-default.png
NUXT_PUBLIC_WHATSAPP_NUMBER=
NUXT_PUBLIC_INSTAGRAM_URL=
NUXT_PUBLIC_FACEBOOK_URL=
NUXT_PUBLIC_GA4_MEASUREMENT_ID=
NUXT_PUBLIC_META_PIXEL_ID=
NUXT_PUBLIC_GOOGLE_ADSENSE_ACCOUNT=

# Auth no browser (chave anon)
NUXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Aliases aceitos pelo backend
NUXT_PRIVATE_SUPABASE_KEY=
NUXT_ADMIN_ALLOWED_EMAILS=
NUXT_ADMIN_REQUIRE_ROLE=false

ADMIN_ALLOWED_EMAILS=
ADMIN_REQUIRE_ROLE=false

# SSR (Compose): NUXT_API_BASE=http://cagtech-backend:3001
# Dev local: NUXT_API_BASE=http://127.0.0.1:3001
