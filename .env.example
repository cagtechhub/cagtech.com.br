# Copie para `.env` só na VPS. Não commitar segredos.

# Apex (sem www). Traefik atende DOMAIN e www.DOMAIN.
DOMAIN=cagtech.com.br

# Rede Docker do Traefik (bridge). Nunca use `host`.
TRAEFIK_NETWORK=web
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# URL pública do site (canônico, Open Graph, sitemap). HTTPS do domínio real — não localhost.
NUXT_PUBLIC_SITE_URL=https://www.cagtech.com.br

# true em preview/staging: noindex + robots.txt bloqueia crawlers
NUXT_PUBLIC_NO_INDEX=false

# Local para título, meta e schema (ex.: São Paulo, SP)
NUXT_PUBLIC_SEO_LOCALITY=Campo Grande, MS

# Telefone internacional (ex.: +5511999999999) — também usado em tel: se vazio usa WhatsApp
NUXT_PUBLIC_BUSINESS_PHONE=+5567992110928
NUXT_PUBLIC_CONTACT_EMAIL=
NUXT_PUBLIC_LINKEDIN_URL=

# Imagem OG (caminho sob a origem pública)
NUXT_PUBLIC_DEFAULT_OG_IMAGE=/og-default.png

NUXT_PUBLIC_WHATSAPP_NUMBER=
NUXT_PUBLIC_INSTAGRAM_URL=
NUXT_PUBLIC_FACEBOOK_URL=
NUXT_PUBLIC_GA4_MEASUREMENT_ID=
# Só carrega após “Aceitar todos” no banner de cookies (LGPD).
NUXT_PUBLIC_META_PIXEL_ID=
NUXT_PUBLIC_GOOGLE_ADSENSE_ACCOUNT=

# Supabase Auth (painel /admin) — chave anon, nunca service_role.
# URL = base do projeto, SEM /rest/v1 (ex.: https://abcdefgh.supabase.co)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase servidor (Nitro: contatos + site_settings). Preferir service_role.
# Local CLI: http://127.0.0.1:54321 — no Docker use host.docker.internal:54321
NUXT_PRIVATE_SUPABASE_URL=
NUXT_PRIVATE_SUPABASE_KEY=
# Schema exposto na API (Settings → API → Exposed schemas). Rode supabase/migrations/*.sql
NUXT_PRIVATE_SUPABASE_SCHEMA=cagtech

# CSV de e-mails autorizados no painel. Vazio = qualquer usuário Auth (só em dev).
NUXT_ADMIN_ALLOWED_EMAILS=
# Se true, exige app_metadata.role === admin
NUXT_ADMIN_REQUIRE_ROLE=false
